#!/bin/sh
# Builds GitHub's main on the Mac (`ssh mac`) for the team's development devices and puts it in hangar, the app on
# Bassim's iPhone that installs his development apps when he taps, from any network (~/Developer/hangar on this box).
# The build number is main's commit count, and the build registers the URL scheme com.bassim.camera-<build>
# (Camera/Info.plist), which hangar opens to know that build is installed and to bring the app back up. Notes default
# to main's last commit.
# Usage: ios/scripts/hangar [--notes '<one line on what changed>']
set -e
cd "$(dirname "$0")/../.."
case $1 in
  ('') notes= ;;
  (--notes) notes=$2 ;;
  (*) echo "usage: ios/scripts/hangar [--notes '<one line on what changed>']" >&2; exit 2 ;;
esac
git fetch -q origin main
build=$(git rev-list --count origin/main)
notes=${notes:-$(git log -1 --format=%s origin/main)}
ssh mac 'rm -rf Developer/camera-hangar && mkdir -p Developer/camera-hangar'
git archive origin/main ios | ssh mac tar -x -C Developer/camera-hangar
ssh mac sh -s "$build" <<'MAC'
set -e
cd ~/Developer/camera-hangar/ios
/opt/homebrew/bin/xcodegen generate -q
scripts/gui "$HOME/.local/bin/turn" xcodebuild build -project Camera.xcodeproj -scheme Camera -destination generic/platform=iOS \
  -configuration Release -derivedDataPath build -allowProvisioningUpdates -quiet CURRENT_PROJECT_VERSION="$1"
mkdir Payload
cp -R build/Build/Products/Release-iphoneos/Camera.app Payload/
ditto -c -k --keepParent Payload Camera.ipa
MAC
dir=$HOME/.local/share/camera/hangar
mkdir -p "$dir"
scp -q mac:Developer/camera-hangar/ios/Camera.ipa "$dir/Camera-$build.ipa"
find "$dir" -name 'Camera-*.ipa' ! -name "Camera-$build.ipa" -delete
"$HOME/Developer/hangar/bin/hangar" put "$dir/Camera-$build.ipa" --notes "$notes"
echo "Camera build $build (main $(git rev-parse --short origin/main)) is in hangar"
