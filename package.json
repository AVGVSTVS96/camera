{
  "name": "camera",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "web",
    "parity"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "diff": "bun parity/diff.ts",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "check": "bun run --cwd web typecheck && oxlint && oxfmt --check",
    "specs": "bun parity/specs.ts",
    "publish:parity": "bun parity/publish.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.92.0",
    "oxfmt": "^0.77.0",
    "oxlint": "1.92.0"
  }
}
